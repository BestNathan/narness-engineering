# .editorconfig — editor baseline
# copy to: <workspace root>/.editorconfig
#
# A convenience layer (editor "format on save"), not the ground truth — that is
# rustfmt.toml + `cargo fmt --all -- --check`. Keep the basics aligned so the
# editor doesn't fight the gate.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
